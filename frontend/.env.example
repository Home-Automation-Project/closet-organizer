# Google Sheets Configuration
# These credentials enable the app to read/write inventory and reminder data
# See GOOGLE_SHEETS_SETUP.md for complete setup instructions

# Google OAuth 2.0 credentials (public/web type)
# Get from: https://console.cloud.google.com/
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com
VITE_GOOGLE_API_KEY=your-api-key-here

# Google Sheets IDs (the long ID in the URL when you open the sheet)
# Format: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
VITE_INVENTORY_SHEET_ID=your-inventory-sheet-id
VITE_REMINDERS_SHEET_ID=your-reminders-sheet-id

# Application environment
VITE_ENV=development

